# Copy this file to .env.local and fill in values for the services you use.
# Never commit .env.local or real credentials.
#
# Supabase (server + browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Solana
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_FALLBACK_URL=
SOLANA_RPC_URL=
NEXT_PUBLIC_TRUSTLAYER_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_USDT_MINT=
NEXT_PUBLIC_EURC_MINT=
NEXT_PUBLIC_PYUSD_MINT=
NEXT_PUBLIC_USDS_MINT=
NEXT_PUBLIC_FDUSD_MINT=
NEXT_PUBLIC_USDC_CLUSTER=devnet
NEXT_PUBLIC_USDT_CLUSTER=devnet
NEXT_PUBLIC_SOL_USD_RATE=
SOL_USD_RATE=

# Aurora Intents (optional)
AURORA_INTENTS_APP_KEY=
NEXT_PUBLIC_AURORA_INTENTS_APP_KEY=
AURORA_SOLANA_SOL_ASSET_ID=
AURORA_SOLANA_USDC_ASSET_ID=
AURORA_SOLANA_USDT_ASSET_ID=

# NEAR Intents (optional; keep credentials server-side)
NEAR_INTENTS_MODE=demo
NEAR_INTENTS_AGENT_API_URL=
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_ID=
NEAR_INTENTS_GRANT_TOKEN=

# Optional OpenAI-compatible agent reasoning provider
TRUSTLAYER_AGENT_AI_BASE_URL=https://api.openai.com/v1
TRUSTLAYER_AGENT_AI_API_KEY=
TRUSTLAYER_AGENT_AI_MODEL=

# Server-side operational secrets (only configure if the corresponding feature is enabled)
TRUSTLAYER_ADMIN_SECRET_KEY=
TRUSTLAYER_API_KEY=
TRUSTLAYER_IDEMPOTENCY_ENCRYPTION_KEY=
TRUSTLAYER_WEBHOOK_SECRETS_JSON=
TRUSTLAYER_WEBHOOK_SECRET_ENCRYPTION_KEY=
TRUSTLAYER_WEBHOOK_WORKER_KEY=
CRON_SECRET=

# Optional support contact
NEXT_PUBLIC_SUPPORT_TELEGRAM_LABEL=
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
